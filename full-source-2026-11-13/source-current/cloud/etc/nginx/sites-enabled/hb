server {
    listen 80;
    server_name hb.lzj2012.top;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name hb.lzj2012.top;

    ssl_certificate     /etc/letsencrypt/live/wildcard.lzj2012.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.lzj2012.top/privkey.pem;

    # 安全响应头 (2026-10-06)
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    location = /favicon.ico { root /var/www/www; }
    location = /favicon.svg { root /var/www/www; }

    add_header X-Robots-Tag "noindex, nofollow" always;
    access_log off;

    location = /hb {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
    }

    location = /ipchange {
        limit_except POST { deny all; }
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;
    }

    location / { return 404; }
}
