# 聊天室 chat.lzj2012.top —— 强制 HTTPS + PHP (php8.2-fpm)
# 由 install.sh 部署; 备份见 /root/backup-chat-*
server {
    listen 80;
    server_name chat.lzj2012.top;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name chat.lzj2012.top;

    ssl_certificate     /etc/letsencrypt/live/wildcard.lzj2012.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.lzj2012.top/privkey.pem;

    # 安全响应头 (2026-10-06)
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # 拒绝隐藏文件 (.user.ini / .git / .env ...), 防止配置/源码被当静态文件下载
    location ~ /\. { deny all; }

    add_header X-Robots-Tag "noindex, nofollow" always;
    client_max_body_size 8m;   # 允许图片上传 (PHP 侧再限 4MB)

    location = /favicon.ico { root /var/www/www; }
    location = /favicon.svg { root /var/www/www; }

    root /var/www/chat;
    index index.php;

    error_page 503 /maintenance.html;
    location = /maintenance.html { internal; root /var/www/maintenance; }

    location = /berserk-status.php {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/berserk-status.php;
        fastcgi_param HTTPS on;
    }

    # API: 全站限速 (每 IP 300 请求/分, 突发 60) —— 3 秒轮询下 NAT 多人共用出口 IP 也不会误 429
    # Mercure SSE (2026-10-18)
    location = /.well-known/mercure {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
        chunked_transfer_encoding off;
        add_header X-Accel-Buffering no;
    }

    # Centrifugo WebSocket (V3.6)
    location = /connection/websocket {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 24h;
        proxy_send_timeout 24h;
    }

    location = /api.php {
        limit_req zone=chatazone burst=60 nodelay;
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root/api.php;
        fastcgi_param HTTPS on;
    }

    location ~ ^/v/([0-9a-f]+)$ { rewrite ^/v/(.*)$ /approve.php?t=$1 last; }

    location ~ \.php$ {
        if (-f /run/berserk-mode) { return 503; }
        include fastcgi_params;
        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
    }

    location / {
        if (-f /run/berserk-mode) { return 503; }
        try_files $uri $uri/ =404;
    }   # 未知路径返回 404, 不再一律落到 index.php(软404)
}
