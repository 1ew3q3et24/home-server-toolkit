server {
    listen 80;
    listen 443 ssl http2;
    server_name panel.lzj2012.top;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    ssl_certificate /etc/letsencrypt/live/wildcard.lzj2012.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.lzj2012.top/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
