server {
    listen 80;
    server_name cftest.lzj2012.top;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    http2 on;
    server_name cftest.lzj2012.top;
    ssl_certificate /etc/letsencrypt/live/wildcard.lzj2012.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.lzj2012.top/privkey.pem;
    root /var/www/cftest;
    index index.html;
    add_header X-Test-Host $host always;
}
