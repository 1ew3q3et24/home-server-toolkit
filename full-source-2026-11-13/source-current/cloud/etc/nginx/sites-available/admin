server {
    listen 80;
    server_name admin.lzj2012.top;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name admin.lzj2012.top;

    ssl_certificate     /etc/letsencrypt/live/wildcard.lzj2012.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wildcard.lzj2012.top/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 8m;

    auth_basic "One API Admin";
    auth_basic_user_file /etc/nginx/one-api.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
