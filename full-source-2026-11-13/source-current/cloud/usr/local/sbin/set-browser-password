#!/bin/bash
set -euo pipefail

HTPASSWD_FILE=/etc/nginx/.htpasswd-browser
PW_FILE=/root/.config/browser-basic
BACKUP_DIR=/root/browser-passwd-backups
USER_NAME="lzj"
umask 077

usage() {
  cat <<'EOF'
用法:
  set-browser-password            # 交互式输入新密码（推荐）
  set-browser-password --random   # 随机生成一个并只在终端显示一次
  set-browser-password --user 名字 # 指定用户名（默认 lzj）
说明:
  同一份密码同时用于 browser.lzj2012.top 与 download.lzj2012.top。
  明文会写入 /root/.config/browser-basic (600)，不会打印到日志。
EOF
}

ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --random) MODE=random; shift ;;
    --user) USER_NAME="$2"; shift 2 ;;
    *) echo "未知参数: $1"; usage; exit 1 ;;
  esac
done

[ "$(id -u)" -eq 0 ] || { echo "需要 root 运行"; exit 1; }
[ -f "$HTPASSWD_FILE" ] || { echo "找不到 $HTPASSWD_FILE"; exit 1; }

mkdir -p "$BACKUP_DIR"
cp -a "$HTPASSWD_FILE" "$BACKUP_DIR/.htpasswd-browser.$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true

if [ "${MODE:-}" = "random" ]; then
  NEW_PASS="$(openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 20)"
  SHOW=1
else
  read -r -s -p "新密码（至少 8 位）: " NEW_PASS; echo
  read -r -s -p "再输入一次: " NEW_PASS2; echo
  [ "$NEW_PASS" = "$NEW_PASS2" ] || { echo "两次输入不一致，未修改"; exit 1; }
  [ "${#NEW_PASS}" -ge 8 ] || { echo "密码至少 8 位，未修改"; exit 1; }
  SHOW=0
fi

if command -v htpasswd >/dev/null 2>&1; then
  htpasswd -cb "$HTPASSWD_FILE" "$USER_NAME" "$NEW_PASS"
else
  printf '%s:%s\n' "$USER_NAME" "$(openssl passwd -apr1 "$NEW_PASS")" > "$HTPASSWD_FILE"
fi

chown root:www-data "$HTPASSWD_FILE" 2>/dev/null || true
chmod 640 "$HTPASSWD_FILE"
printf '%s\n' "$NEW_PASS" > "$PW_FILE"
chmod 600 "$PW_FILE"

nginx -t >/dev/null 2>&1 && systemctl reload nginx
echo "已更新用户 $USER_NAME 的密码；明文在 $PW_FILE (600)"
[ "$SHOW" = 1 ] && echo "本次生成的新密码: $NEW_PASS"
exit 0
